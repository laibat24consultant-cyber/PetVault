# Copy this file to .env for Docker Compose and replace the placeholder values.
# Keep .env out of source control.
NODE_ENV=development
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Local project mode: fixed OTPs are returned to the app for development.
DEV_AUTH_CODES=true
OTP_TTL_MINUTES=10

# Optional real email delivery. Verify the sender domain in Resend, add a real
# API key, and set DEV_AUTH_CODES=false before enabling these values.
# EMAIL_PROVIDER=resend
# EMAIL_FROM=PetVault <no-reply@your-verified-domain.example>
# RESEND_API_KEY=re_your_resend_api_key

# Project demo checkout only. This approves a mock payment; it never charges a card.
PAYMENT_PROVIDER=mock
