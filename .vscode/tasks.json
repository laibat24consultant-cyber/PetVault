{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PetVault: start backend",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "up",
                "--build",
                "-d"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "PetVault: stop backend",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "down"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
